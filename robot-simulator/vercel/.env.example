# Prepared from only public runtime code; never from a visitor's running session.
ROBOT_SNAPSHOT_ID=
# Hard creation ceiling, enforced by unique UTC-day slot names (1–20).
ROBOT_DAILY_SESSIONS=10
# Admission check; simultaneous requests may exceed this up to the daily ceiling.
ROBOT_CONCURRENT_SESSIONS=2
ROBOT_SESSION_MINUTES=30

# Required server-only access secrets. Never put real values in Git.
ROBOT_ACCESS_PASSWORD_HASH=
ROBOT_ACCESS_SECRET=
