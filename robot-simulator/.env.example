# The simulator host, not the GitHub Pages wiki URL. No trailing slash.
ROBOT_PUBLIC_ORIGINS=https://simulator.example.com
# Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN after generating a domain.
PORT=8000
ROBOT_MAX_VISITORS=2
ROBOT_VISITOR_TTL_SECONDS=1800
ROBOT_KEY_TTL_SECONDS=1800
# Use * only when the port is isolated behind a trusted TLS-terminating proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
